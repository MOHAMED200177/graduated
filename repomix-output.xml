          const ease = easeOutElastic(t);
          const rad = (petal.angle * Math.PI) / 180;
          const dist = PETAL_DIST * ease;
          const x = 50 + (Math.cos(rad) * dist * 100) / 500;
          const y = 50 + (Math.sin(rad) * dist * 100) / 500;
          const isActive = activePetal === i;

          return (
