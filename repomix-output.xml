          >
            <div
              style={{
                width: "32px",
                height: "2px",
                background: active.color,
                margin: "0 auto 20px",
                opacity: 0.6,
              }}
            />
            <p
              style={{
                fontFamily: "DM Sans, sans-serif",
                fontSize: "10px",
                letterSpacing: "0.25em",
                color: active.color,
                marginBottom: "10px",
              }}
            >
              {active.year}
            </p>
            <h3
              style={{
                fontFamily: "Cormorant Garamond, serif",
                fontSize: "clamp(1.2rem, 2.5vw, 1.6rem)",
