        </div>

        {/* Input */}
        <div style={{ position: "relative", marginBottom: "20px" }}>
          <input
            ref={inputRef}
            value={answer}
            onChange={(e) => setAnswer(e.target.value)}
            onKeyDown={(e) => e.key === "Enter" && handleSubmit()}
            placeholder="اكتب إجابتك..."
            dir="rtl"
            style={{
