            left: "50%",
            top: "50%",
            transform: "translate(-50%,-50%)",
            width: "72px",
            height: "72px",
            borderRadius: "50%",
            background:
              "radial-gradient(circle at 35% 35%, #E8A4C8, #C2185B 60%, #7B0D3A)",
            boxShadow:
              "0 0 30px rgba(194,24,91,0.5), 0 0 60px rgba(194,24,91,0.2)",
            zIndex: 10,
            display: "flex",
