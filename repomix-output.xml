            textShadow:
              "0 0 40px rgba(194,24,91,0.6), 0 0 80px rgba(194,24,91,0.3)",
            opacity: stateRef.current.nameVisible ? 1 : 0,
            transition: "opacity 0.3s ease",
          }}
        >
          {"Abeer".split("").map((char, i) => (
            <span
              key={i}
              style={{
