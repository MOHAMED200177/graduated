              fontStyle: "italic",
              paddingTop: "30px",
            }}
          >
            ✦ اضغط على أي بتلة لتقرأ اللحظة
          </p>
        )}
      </div>

      <style>{`
        @keyframes petalReveal {
          from { opacity: 0; transform: translateY(16px) scale(0.97); }
          to   { opacity: 1; transform: translateY(0)   scale(1);    }
        }
      `}</style>
    </section>
  );
}
